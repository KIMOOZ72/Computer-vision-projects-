        "import cv2, time\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "img  = cv2.imread('/content/images.jpg')\n",
        "gray = cv2.cvtColor(img, cv2.COLOR_BGR2GRAY).astype(np.float64)\n",
        "\n",
        "plt.figure(figsize=(6, 6))\n",
        "plt.imshow(gray, cmap='gray')\n",
        "plt.title(\"Original Grayscale Image\")\n",
        "plt.axis('off')\n",
        "plt.show()\n"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "def add_gaussian_noise(g, sigma=15):\n",
        "    return np.clip(g + np.random.normal(0, sigma, g.shape), 0, 255)\n",
        "\n",
        "def add_salt_pepper(g, p=0.05):\n",
        "    out = g.copy();\n",
        "    r = np.random.rand(*g.shape)\n",
        "    out[r < p/2] = 0;\n",
        "    out[r > 1 - p/2] = 255\n",
        "    return out\n"
      ],
      "metadata": {
        "id": "9vdcydAwzPy_"
      },
      "execution_count": 2,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "def my_convolve(image, kernel):\n",
        "    kh, kw = kernel.shape\n",
        "    ph, pw = kh // 2, kw // 2\n",
        "    padded = np.pad(image, ((ph, ph), (pw, pw)))\n",
        "    out = np.zeros_like(image)\n",
        "    k = np.flip(kernel)\n",
        "    for i in range(image.shape[0]):\n",
        "        for j in range(image.shape[1]):\n",
        "            region = padded[i:i+kh, j:j+kw]\n",
        "            out[i, j] = np.sum(region * k)\n",
        "    return out\n"
      ],
      "metadata": {
        "id": "1JsNMUjAza0L"
      },
      "execution_count": 3,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "box_kernel = np.ones((3, 3), dtype=np.float64) / 9\n",
        "small = cv2.resize(gray, (256, 256))\n",
        "my_result = my_convolve(small, box_kernel)\n",
        "\n",
        "plt.figure(figsize=(10, 4))\n",
        "\n",
        "plt.subplot(1, 2, 1)\n",
        "plt.imshow(small, cmap='gray')\n",
        "plt.title(\"Original\")\n",
        "plt.axis('off')\n",
        "\n",
        "plt.subplot(1, 2, 2)\n",
        "plt.imshow(my_result, cmap='gray')\n",
        "plt.title(\"My 3x3 Box Filter\")\n",
        "plt.axis('off')\n",
        "\n",
        "plt.show()\n",
        "\n",
        "#2\n",
        "cv_result = cv2.filter2D(\n",
        "    small,\n",
        "    ddepth=-1,\n",
        "    kernel=box_kernel,\n",
        "    borderType=cv2.BORDER_CONSTANT\n",
        ")\n",
        "\n",
        "diff = np.abs(my_result - cv_result)\n",
        "\n",
        "print(\"Maximum absolute difference:\")\n",
        "print(np.max(diff))\n",
        "\n",
        "\n"
      ],
